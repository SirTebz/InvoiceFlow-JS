PORT=3000
DATABASE_URL=./data/quiktab.sqlite
SESSION_SECRET=change-this-local-secret
APP_URL=http://localhost:3000

# Email Configuration
EMAIL_PROVIDER=mock
EMAIL_FROM=QuikTab <invoices@example.test>

# Production SMTP Configuration (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=false

# Billing Configuration
BILLING_PROVIDER=mock
FREE_PLAN_MONTHLY_INVOICE_LIMIT=10

# PayFast Online Payments
# PAYFAST_SANDBOX=true uses https://sandbox.payfast.co.za
# Set PAYFAST_SANDBOX=false for production (https://www.payfast.co.za)
# Note: Merchant credentials (Merchant ID, Merchant Key, Passphrase) are configured
# per-business in the application under Settings -> Business Settings.
PAYFAST_SANDBOX=true

# Internal Cron / Automation Key
# Used for protected internal execution endpoints such as POST /api/internal/recurring/process
INTERNAL_KEY=dev-internal-key
