PORT=3000
DATABASE_URL=./data/invoiceflow.sqlite
SESSION_SECRET=change-this-local-secret
APP_URL=http://localhost:3000

# Email Configuration
EMAIL_PROVIDER=mock
EMAIL_FROM=InvoiceFlow <invoices@example.test>

# Production SMTP Configuration (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=false

# Billing Configuration
BILLING_PROVIDER=mock
FREE_PLAN_MONTHLY_INVOICE_LIMIT=10
